# =============================================================================
# DocuMind AI - environment template
#
# Copy to the app you are running and fill in the values:
#   apps/backend/.env    - API
#   apps/functions/local.settings.json - worker (Values block, same keys)
#   apps/frontend/.env   - web app (VITE_* only)
#
# In Azure none of this is used: App Service and the Function App receive these
# as application settings, wired up by infra/main.bicep, with every secret held
# as a Key Vault reference. Fetch real values from Key Vault, for example:
#   az keyvault secret show --vault-name <kv-name> --name DATABASE-URL \
#     --query value -o tsv
# =============================================================================

# --- Database ----------------------------------------------------------------
# Prisma's `sqlserver` provider requires this JDBC-style URL. The ADO.NET form
# ("Server=tcp:...;Initial Catalog=...") will NOT parse.
# Bicep writes this to the Key Vault secret DATABASE-URL.
DATABASE_URL="sqlserver://<server>.database.windows.net:1433;database=<db>;user=<user>;password=<password>;encrypt=true;trustServerCertificate=false"

# --- Authentication ----------------------------------------------------------
# Minimum 32 characters; the API refuses to start without it. There is no
# fallback value. Generate one with:  openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# --- API ---------------------------------------------------------------------
PORT=4000
NODE_ENV="development"

# Comma-separated list of browser origins allowed to call the API. Required when
# NODE_ENV=production. In Azure, Bicep sets this to the frontend Web App origin.
CORS_ORIGINS="http://localhost:5173"

# Maximum upload size in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760

# --- Azure Storage (Blob) ----------------------------------------------------
# Key Vault secret: STORAGE-CONNECTION-STRING
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="documents"

# --- Azure Service Bus -------------------------------------------------------
# The API needs a Send-only string, the worker a Listen-only string.
# Key Vault secrets: SERVICE-BUS-SEND-CONNECTION-STRING
#                    SERVICE-BUS-LISTEN-CONNECTION-STRING
AZURE_SERVICE_BUS_CONNECTION_STRING=""
AZURE_SERVICE_BUS_QUEUE="document-processing"

# --- Azure OpenAI ------------------------------------------------------------
# Key Vault secret: AZURE-OPENAI-KEY
# The *_DEPLOYMENT_ID values are deployment names, not model names. Bicep creates
# deployments matching the defaults below.
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_DEPLOYMENT_ID="gpt-4o-mini"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_ID="text-embedding-3-small"

# --- Azure AI Search ---------------------------------------------------------
# Key Vault secret: SEARCH-ADMIN-KEY
# The index is NOT created by Bicep. Run `npm run search:index` once the search
# service exists, otherwise every upload fails at the indexing step.
AZURE_SEARCH_ENDPOINT=""
AZURE_SEARCH_INDEX="documents"
AZURE_SEARCH_KEY=""

# --- Azure Communication Services (worker only, optional) --------------------
# Key Vault secret: COMMUNICATION-CONNECTION-STRING
# Email is best-effort: the worker completes processing even if these are unset.
AZURE_COMMUNICATION_CONNECTION_STRING=""
AZURE_COMMUNICATION_SENDER_EMAIL="DoNotReply@<your-acs-domain>"

# --- Worker tuning (optional) ------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_SUMMARY_CHARS=48000

# --- Frontend ----------------------------------------------------------------
# The backend ORIGIN ONLY - no trailing /api. Every call site already prefixes
# /api, so "http://localhost:4000/api" produces requests to /api/api/... .
#
# Vite inlines this at BUILD time, so it must be set when `vite build` runs. An
# App Service application setting cannot change an already-built bundle; CI reads
# it from the infrastructure deployment output instead.
#
# Leave empty locally to route through the Vite dev proxy on the same origin.
VITE_API_URL="http://localhost:4000"
