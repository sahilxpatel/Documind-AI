# Database
# Supplied manually after Azure SQL is created (or from deployment outputs)
DATABASE_URL="sqlserver://<server-name>.database.windows.net:1433;database=<db-name>;user=<user>;password=<password>;encrypt=true"

# Authentication
# Supplied manually
JWT_SECRET="your-super-secret-jwt-key"

# App
PORT=4000
NODE_ENV="development"

# Azure Storage (Blob)
# Note: From Bicep deployment output or Azure Portal
AZURE_STORAGE_CONNECTION_STRING=""

# Azure Service Bus
# Note: From Bicep deployment output or Azure Portal
AZURE_SERVICE_BUS_CONNECTION_STRING=""

# Azure OpenAI
# Note: From Bicep deployment output or Azure Portal
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_DEPLOYMENT_ID="gpt-4"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_ID="text-embedding-ada-002"

# Azure AI Search
# Note: From Bicep deployment output or Azure Portal
AZURE_SEARCH_ENDPOINT=""
AZURE_SEARCH_INDEX="documents"
AZURE_SEARCH_KEY=""

# Azure Communication Services (Email)
# Note: From Bicep deployment output or Azure Portal
AZURE_COMMUNICATION_CONNECTION_STRING=""
AZURE_COMMUNICATION_SENDER_EMAIL="donotreply@<your-acs-domain>"

# Frontend
# Supplied manually (usually the Backend App Service URL, e.g., https://app-backend-documind-dev.azurewebsites.net/api)
VITE_API_URL="http://localhost:4000/api"
